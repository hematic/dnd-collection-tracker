# Komodo: paste these into the Stack's Environment. Plain docker: copy to .env.

# Pin this to a release version for predictable updates.
DND_TRACKER_IMAGE=hematic/dnd-collection-tracker:latest

# Where the database + covers live on the server (absolute path, NOT inside the repo).
DND_DATA_DIR=/opt/appdata/dnd-tracker

# Who may edit (comma-separated). Matched against TinyAuth's Remote-User / Remote-Email.
# Everyone else who can log in gets read-only access.
DND_TRACKER_ADMINS=you@example.com

# Host folder containing the PDF library (read-only in the container).
DND_PDF_DIR=/mnt/dnd/Books

# Optional: translate paths already stored in the database to the container mount.
# Use single quotes in a .env file, e.g. DND_TRACKER_PDF_MAP='\\nas\Books=/pdfs'
DND_TRACKER_PDF_MAP=

# Host port Traefik routes to.
DND_PORT=8765

# Relative Docker CPU scheduling priority (not a hard CPU limit).
# Leave at 1024 by default; adjust the OCR worker independently if needed.
DND_TRACKER_CPU_SHARES=1024
DND_OCR_CPU_SHARES=1024

# Traefik's IP. The app refuses requests from anywhere else.
TRAEFIK_IP=

# Owner of DND_DATA_DIR on the server (run `id` to see yours).
PUID=1000
PGID=1000
